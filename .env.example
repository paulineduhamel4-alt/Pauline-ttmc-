# ==== Obligatoire ====
# Ta clé API Anthropic (https://console.anthropic.com)
ANTHROPIC_API_KEY=sk-ant-api03-...

# ==== Sécurité (recommandé en production) ====
# Code PIN 4-8 chiffres. Vide = accès libre.
APP_PIN=1234

# ==== Optionnel ====
# claude-haiku-4-5-20251001 = rapide + pas cher (défaut)
# claude-sonnet-5           = meilleure qualité, plus lent + plus cher
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# Port du serveur (défaut 3001 en dev, auto sur Render)
PORT=3001
