# ==== Obligatoire ====
# Ta clé API Google Gemini (100% GRATUITE)
# → https://aistudio.google.com/app/apikey (login Google, "Create API key")
GEMINI_API_KEY=AIzaSy...

# ==== Sécurité (recommandé en production) ====
# Code PIN 4-8 chiffres. Vide = accès libre.
APP_PIN=1234

# ==== Optionnel ====
# gemini-2.5-flash        = qualité recommandée (défaut)
# gemini-2.5-flash-lite   = plus rapide, un poil moins bon
# gemini-2.0-flash        = version antérieure, plus généreuse en rate limit
GEMINI_MODEL=gemini-2.5-flash

# Nombre de générations en parallèle (baisser si tu tapes les rate limits)
GEN_CONCURRENCY=8

# Port du serveur (auto sur Render)
PORT=3001
