# Ta clé API Anthropic (obtenue sur https://console.anthropic.com)
ANTHROPIC_API_KEY=sk-ant-api03-...

# Optionnel : changer de modèle
# claude-haiku-4-5-20251001 = rapide + pas cher (défaut, recommandé)
# claude-sonnet-5           = meilleure qualité, plus lent + plus cher
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# Port du serveur backend (défaut 3001)
PORT=3001
